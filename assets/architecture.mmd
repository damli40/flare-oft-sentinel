%% OFT Sentinel on Flare — one cycle, end to end.
%% Rendered to assets/architecture.png. Regenerate with:
%%   npx -y @mermaid-js/mermaid-cli -i assets/architecture.mmd -o assets/architecture.png -b white -s 2
flowchart TB
    subgraph pick["1 · Choose what to watch"]
        direction LR
        dune["Dune query 8185729<br/>at least 10 LayerZero<br/>messages in 7 days"]
        pinned["WATCH_PINNED<br/>4 hand-pinned OFTs<br/>(incl. our demo OFT)"]
        scope["watch-scope.ts<br/>WATCH_CHAINS allowlist"]
        dune --> scope
        pinned --> scope
    end

    subgraph read["2 · Read the live configuration"]
        direction LR
        rpc["Flare Mainnet · chain-registry.json<br/>3 endpoints, 3 separate companies<br/>every send-side config read TWICE, on two of them<br/>they disagree → CRITICAL, never a retry until they agree<br/>the third is failover, not a vote"]
        meta["LayerZero DVN metadata<br/>public API<br/>chain coverage grows over time"]
        lz["lz-config.ts<br/>one snapshot per corridor:<br/>DVNs, libraries, confirmations"]
        rpc --> lz
        meta --> lz
    end

    subgraph rules["3 · Score it"]
        direction LR
        cust["custody.ts<br/>operator declarations<br/>ships empty"]
        drift["drift.ts · RULES_VERSION 5.0.0<br/>fixed checks, no LLM"]
        score["score.ts<br/>one deduction per check,<br/>at its worst severity"]
        cust --> drift
        drift --> score
    end

    %% ── Leg A: sign it ────────────────────────────────────────────────────
    gate{{"THE ATTEST GATE<br/>Unset, as it ships here and in production:<br/>sign every watched asset, every band.<br/>Set ATTEST_SCOPE to an allowlist and only<br/>ATTEST_PINNED signs. Set it to anything we<br/>cannot parse and it signs NOTHING."}}
    reg[("AuditRegistry<br/>Flare Mainnet · chainId 14<br/>0x2d2b385e…2Dd144<br/>asset, chain, verdict hash,<br/>score, band. No finding text.")]
    resign["total() runs ahead of the asset count.<br/>&nbsp;<br/>A config that changes gets a second record and the registry keeps both,<br/>so it is one record per change, not one per asset.<br/>countOf / historyOf walk the trail.<br/>&nbsp;<br/>Most of today's excess was a bug, fixed 2026-08-12. A far-side read<br/>failure does not go quiet: the engine falls back to the near side, marks<br/>the finding INFERRED, and says so in the text. That weaker reading<br/>replaced the good one and the asset re-signed with nothing changed.<br/>7 records on one asset in 2 days, all identical 10/CRITICAL.<br/>&nbsp;<br/>Now a weaker reading never overwrites a stronger one, unless it is MORE<br/>severe. The hash still covers the full text on purpose: drift compares<br/>the send side only, so a receive-side DVN swap at an unchanged count<br/>lives nowhere but those names."]
    nosign["no transaction<br/>a scope we cannot interpret<br/>signs nothing, and never guesses"]

    %% ── Leg B: keep saying it ─────────────────────────────────────────────
    alert{{"THE ALERT GATE<br/>dispatchAlert() returns on PASS.<br/>A clean asset is signed and never spoken about."}}
    first["FIRST TIME: Telegram, plus an AlertBus<br/>transaction and a dust nudge to the OFT owner"]
    again["THE REMINDER: Telegram only<br/>CRITICAL every 12h · AT_RISK every 7d · PASS never<br/>No second attestation. No AlertBus. No second nudge.<br/>Nobody fixed it, so the chain has nothing new to record."]
    quiet["On THIS instance: Telegram is LIVE and the cadence is firing.<br/>ALERT_BUS_ADDRESS stays unset, so the on-chain leg never runs<br/>and every message reads 'AlertBus: not sent'. Two of the six are<br/>live third-party tokens, and dusting their owners to announce a<br/>finding is not this deployment's call to make.<br/>Signer 0xf374113b…0e66 has never sent a transaction on Flare that<br/>was not an attestation: its nonce equals the registry's total().<br/>Check both and they match. That is the reason this box can say this."]

    %% ── Leg C: publish it ─────────────────────────────────────────────────
    api["GET /api/sentinel/status<br/>the whole read,<br/>nothing filtered out"]
    filt{{"isDemoAsset()<br/>chain + address of the OFT<br/>we deployed, pinned in<br/>WATCH_PINNED. Not what<br/>gets signed. Fails closed."}}
    ours["MOFT, ours<br/>full findings, DVN names,<br/>attestation link"]
    theirs["any third-party OFT<br/>same score, same band,<br/>finding count, corridor<br/>structure. No finding text,<br/>no operator names."]

    %% ── Leg D: what a fix would score ─────────────────────────────────────
    tis["tis[] · one entry per fixable finding<br/>intent, the state read, the state wanted,<br/>and the score that fix would produce"]
    fix["ROADMAP, NOT BUILT<br/>emit the setConfig call itself,<br/>so an operator reviews a transaction<br/>instead of a description of one.<br/>Read tools stay read tools."]

    %% ── Before you deploy at all ──────────────────────────────────────────
    agent["an agent, before it deploys<br/>mcp/ in this repo · 6 read and validate tools<br/>no write path, no private key"]
    val["POST /api/sentinel/validate<br/>pure: no attestation, no alert,<br/>no stored state<br/>free, no key, X402_ENABLED=false"]
    agent --> val
    val -.-> rules

    ftso["FTSOv2 · the oracle enshrined in Flare's consensus<br/>0x7BDE3Df0…c1d20 · free eth_call, no fee<br/>prices what each contract custodies:<br/>lockbox balance, native balance, or supply<br/>ranks the fleet, never scores it"]

    scope --> read
    lz --> rules
    %% Deliberately NO edge in from the RPC node. The label already says it is a
    %% free eth_call, and drawing the inbound edge pushed this node under stage 2,
    %% which routed its ONE outgoing arrow across the attest gate. On a diagram
    %% whose whole claim is that the price reaches neither scoring nor signing,
    %% an arrow that appears to touch either is worse than a missing one.
    ftso -->|"holdings, priced"| api

    score --> gate
    score --> alert
    score --> api
    score --> tis

    gate -->|"first sight, and whenever the findings change"| reg
    gate -.->|"a scope we cannot read"| nosign
    reg -.- resign

    %% Declared first-fire first so it lands LEFT of the reminder. Mermaid lays
    %% siblings out in edge-declaration order, and a reader who meets the repeat
    %% before the thing being repeated has to read the pair twice.
    alert -->|"new, or the config drifted"| first
    alert -->|"CRITICAL or AT_RISK, unchanged and overdue"| again
    first -.- quiet
    again -.- quiet

    api --> filt
    filt -->|ours| ours
    filt -->|theirs| theirs

    tis -.->|"the last step"| fix

    classDef stage fill:#ffffff,stroke:#c2c2d2,color:#1b1b28
    classDef gateStyle fill:#fff1d9,stroke:#d08b12,color:#3a2a06,font-weight:bold
    classDef chain fill:#e3eeff,stroke:#3f74c8,color:#0d233f
    classDef quiet fill:#f0f0f0,stroke:#b4b4b4,color:#3d3d3d
    class dune,pinned,scope,rpc,meta,lz,cust,drift,score,api,ours,theirs,first,again stage
    classDef preflight fill:#eef7ee,stroke:#5a9c5a,color:#143014
    class agent,val preflight
    class tis stage
    %% Dashed and grey so nothing here can be mistaken for something that runs.
    classDef roadmap fill:#fafafa,stroke:#9a9aa8,color:#55555f,stroke-dasharray: 6 4
    class fix roadmap
    %% Footnotes, not steps. Same grey as the fail-closed box so the eye reads
    %% all three as "read this if you are checking us", never as pipeline stages.
    class nosign,resign,quiet quiet
    %% THREE gates now carry colour, and they are the three decisions a judge
    %% should attack: what gets signed, what gets said out loud, and whose
    %% finding text gets shown.
    class gate,filt,alert gateStyle
    %% Blue with the registry, because both are reads of Flare's own contracts.
    %% It deliberately has NO edge into score.ts: the absence is the claim.
    class reg,ftso chain

    style pick fill:#f6f6fa,stroke:#dcdce6,color:#3a3a4a
    style read fill:#f6f6fa,stroke:#dcdce6,color:#3a3a4a
    style rules fill:#f6f6fa,stroke:#dcdce6,color:#3a3a4a
