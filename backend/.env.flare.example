# backend/.env.flare.example — Flare hackathon instance
WATCH_CHAINS=flare

# WATCH_PINNED — what this instance READS and scores.
# The Flare OFT fleet: USDT0 and FXRP arrive from the Dune watchlist on their own
# (>=10 messages / 7 days), so they are deliberately NOT listed here — pinning them
# too would double-list them. FLR, DINERO and UP have real all-time volume but fall
# under the activity rule, and MOFT is our own demo token with no history at all, so
# all four are pinned by hand. Reading a contract costs an RPC call and asserts nothing.
WATCH_PINNED=flare:0x8d9d1bb7266c27750e64acb84a9706b541007fe5:FLR,flare:0xbe6d2be4e01d4304a28edd13038311e112313ec8:DINERO,flare:0xe030a89fd2b7f858c8aa47725679ca25d467dfd1:UP,flare:0x560C03079FE54Fa53e15b48C615b1ef76D6DF621:MOFT

# ATTEST_PINNED — what may be SIGNED on-chain. Deliberately NOT the same list.
#
# These two lists are separate on purpose; do not "simplify" them back into one.
# Watching a token is a read. Writing a verdict about it into a permanent public
# registry is a claim about somebody else's contract, and FLR, DINERO and UP are
# live third-party tokens we have no standing to sign about at all. That reason
# is not a version number and never was: an earlier note here tied it to rules
# 4.1.0, which read as if shipping 5.0.0 would retire it. 5.0.0 is live and the
# reason is unchanged — it was never about the scoring.
# They were one list until 2026-08-05: the attest gate matched any WATCH_PINNED
# entry, so widening the watch list to cover the fleet silently made all three
# signable, and the first authorised poll would have attested FLR and DINERO.
# Caught by measurement before any transaction was sent. Widening what you look
# at must never widen what you sign.
#
# ATTEST_SCOPE=allowlist restricts signing to ATTEST_PINNED and nothing else.
# It fails closed: an unset, empty or unparseable ATTEST_PINNED attests NOTHING and
# never falls back to WATCH_PINNED or to everything. Leave ATTEST_SCOPE unset for
# production (the Mantle instance), where attesting the whole watched fleet is
# correct. Any other value is rejected and also attests nothing.
ATTEST_SCOPE=allowlist
ATTEST_PINNED=flare:0x560C03079FE54Fa53e15b48C615b1ef76D6DF621:MOFT

FLARE_SENTINEL_QUERY_ID=8185729
DUNE_API_KEY=
SENTINEL_CHAIN_ID=14
SENTINEL_CHAIN_NAME=Flare
SENTINEL_RPC=https://flare-api.flare.network/ext/C/rpc
AUDIT_REGISTRY_ADDRESS=0x2d2b385eb0375aBD74d5174a4f738B0B142Dd144
SENTINEL_PRIVATE_KEY=
# ADMIN_TOKEN — bearer token for the operator-only routes (POST /poll, the replay and
# reset routes, the declarations API). Unset or empty, every one of them answers 404 and
# is unreachable; the scheduled in-process poller is not affected either way.
ADMIN_TOKEN=
# Telegram deliberately unset — unset is what turns alerts off on this branch.
# (There is no ALERTS_DISABLED here; an unset TELEGRAM_BOT_TOKEN short-circuits
# sendTelegram before any network call, and an absent ALERT_BUS_ADDRESS makes the
# on-chain AlertBus path throw before it can sign anything.)

# X402_ENABLED — the agent-payments challenge on POST /validate.
#
# That route is a listed paid agent service on ONE deployment, and every other
# instance inherits the code. Left on, this instance answers `402 Payment
# Required` to a bare GET or a body-less POST, advertising a resource URL on a
# host that is not this one. On a free endpoint published to hackathon judges
# that reads as a paywall, so it is off here and /validate answers a body-less
# caller with a plain description of what it wants.
#
# Off here, and ONLY here: unset keeps the listed deployment behaving exactly as
# it does today. The comparison is against the exact string "false", so a stray
# "False" cannot silently stop a live payment path.
#
# It could not be re-pointed at Flare in any case. Flare's own x402 guide
# (dev.flare.network/fxrp/token-interactions/x402-payments) targets Coston2
# testnet with a MockUSDT0 you deploy yourself, because the scheme needs EIP-3009
# `transferWithAuthorization` and the doc says FXRP gets support "once it
# implements" it. Measured on Flare Mainnet 2026-08-08: neither USDT0 nor FXRP
# exposes transferWithAuthorization, receiveWithAuthorization,
# authorizationState or DOMAIN_SEPARATOR. Every one reverts.
X402_ENABLED=false
